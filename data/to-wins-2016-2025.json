{
  "title": "NFL regular-season wins vs takeaways / turnovers, 2016-2025",
  "pulled_date": "2026-08-24",
  "methodology": {
    "scope": "Regular season only (game_type=REG). Playoffs excluded. Seasons 2016-2025 inclusive.",
    "unit": "team-season (32 clubs x 10 seasons)",
    "games": "2016-2020: 16-game season. 2021 and 2023-2025: 17-game season. 2022: 17 games except BUF and CIN (16) after the Week 17 BUF-CIN game was cancelled.",
    "wins": "Wins from completed regular-season games in nflverse schedules (Lee Sharpe games.csv). Ties count as 0 wins. Cancelled/unplayed games (empty scores) excluded.",
    "takeaways": "def_interceptions + fumble_recovery_opp (defensive INTs + opponent fumbles recovered). Matches official takeaways.",
    "giveaways": "passing_interceptions + fumbles_lost_total (INTs thrown + fumbles lost). Matches official giveaways/turnovers.",
    "to_diff": "takeaways minus giveaways",
    "ranks": "Within each season, 1 = best. Takeaway rank: most takeaways. Giveaway rank: fewest giveaways. TO-diff rank: most positive differential. Ties use average ranks (e.g. two teams tied for 1st both get 1.5).",
    "rank_bands": "Bands use the average rank value: 1-8 if rank<=8; 9-16 if 8<rank<=16; 17-24 if 16<rank<=24; 25-32 if rank>24.",
    "correlations": "Pearson r and Spearman rho of regular-season wins vs each metric across all team-seasons. Two-sided p-values from a Student-t approximation on n-2 df.",
    "leaders": "Each season, all teams tied for the league-best raw total (most takeaways, or fewest giveaways) are counted as #1.",
    "team_codes": "Schedule historical codes remapped to stats codes: SD->LAC, OAK->LV. LA used for Rams.",
    "spot_checks": "2016 KC: 33 takeaways, 17 giveaways, +16 (matches Football Database / published league TO table). 2024 PHI: 26 takeaways, 15 giveaways, +11 (matches Football Database).",
    "caveat": "Takeaways and turnovers are partly luck (especially fumble recovery luck). Good teams run more and play with leads, so giveaways can be confounded by game script and play-call mix. Correlations are descriptive, not causal."
  },
  "source": {
