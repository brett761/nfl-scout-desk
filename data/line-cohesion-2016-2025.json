{
  "title": "NFL offensive- and defensive-line cohesion vs regular-season wins, 2016-2025",
  "pulled_date": "2026-08-24",
  "methodology": {
    "scope": "Regular season only (game_type=REG). Playoffs excluded. Continuity windows 2015->2016 through 2024->2025 (10 YoY pairs). 2015 snap counts used only to score 2016 returning starters.",
    "unit": "team-season (32 clubs x 10 seasons = 320). Includes the 2017 Browns (0-16); zero-win seasons are valid observations.",
    "starter_definition": "Snap-based, not depth-chart. OL unit = 5 players with the most regular-season offensive snaps at that club that year among positions C/G/T/OT/OG/OL and listed hybrids C/G, G/C, G/OT, G/T, T/G. TE excluded. DL unit = 4 players with the most regular-season defensive snaps among DE/DT/NT/DL/EDGE and DE/DT/NT/DL-leading hybrids (DE/D, DE/L, DT/D). ILB/MLB/OLB/LB excluded even if they rush. Unit size is always 5 OL and 4 DL so 3-4 fronts still contribute a top-4 DL-snap group.",
    "returning_starter": "pfr_player_id present in both year Y-1's top-N unit and year Y's top-N unit on the same remapped club. ol_return in 0..5, dl_return in 0..4.",
    "player_key": "pfr_player_id from nflverse snap_counts (PFR IDs). One consistent key; gsis_id is not in the snap file.",
    "wins": "Regular-season wins from nflverse schedules (Lee Sharpe games.csv), game_type=REG. Ties count as 0 wins. Cancelled/unplayed games (empty scores) excluded. d_wins = wins_Y - wins_Y-1. Wins match desk file to-wins-2016-2025.csv (0 mismatches).",
    "team_codes": "Historical codes remapped: SD->LAC, OAK/RAI->LV, STL->LA. Continuity follows the franchise, not the city code.",
    "games": "2016-2020: 16-game season. 2021 and 2023-2025: 17-game season. 2022: 17 games except BUF and CIN (16) after the Week 17 BUF-CIN game was cancelled.",
    "correlations": "Pearson r of ol_return / dl_return / (ol_return+dl_return) vs wins_Y and vs d_wins. Two-sided p-values from a Student-t approximation on n-2 df via the regularized incomplete beta.",
    "intact_line": "ol_return >= 4 AND dl_return >= 3 versus everyone else.",
    "churned_line": "ol_return <= 1 OR dl_return <= 1.",
    "optional_tenure": "Mean years on club among the current unit was not computed (roster entry-year join skipped).",
    "caveats": [
      "Good teams re-sign their lines (selection). A wins_Y association can just mean good clubs keep starters.",
      "d_wins is the more honest test; it differences out the stable-quality effect.",
      "Injuries create churn that also costs wins, so low return is not only roster-construction choice.",
      "4-3 vs 3-4 makes the DL unit noisier; 3-4 edge rushers tagged OLB/LB are excluded by design.",
      "Snap-based season-long top-N is not the same as official Week 1 starters or a single depth chart.",
      "PFR snap position tags include occasional hybrids; 2020 has more hybrid labels than other years."
    ]
  },
